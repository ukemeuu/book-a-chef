# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key — server-side only, NEVER expose to client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App URL (used for canonical URLs, sitemaps, OG tags)
NEXT_PUBLIC_SITE_URL=https://bookachef.co.ke

# M-Pesa Daraja (Safaricom) — leave blank until configured
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://bookachef.co.ke/api/payments/mpesa/callback
MPESA_ENVIRONMENT=sandbox

# Email (Resend — optional, leave blank to disable email notifications)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@bookachef.co.ke
