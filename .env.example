# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key — server-side only, NEVER expose to client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App URL (used for canonical URLs, sitemaps, OG tags)
NEXT_PUBLIC_SITE_URL=https://bookachef.co.ke

# M-Pesa Daraja (Safaricom) — leave blank until configured
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://bookachef.co.ke/api/payments/mpesa/callback
MPESA_ENVIRONMENT=sandbox

# Email (Resend — optional, leave blank to disable email notifications)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@bookachef.co.ke

# WhatsApp Business Cloud API (Meta — optional, leave blank to disable
# outbound WhatsApp notifications). Templates must be approved in the
# WhatsApp Manager before they can be sent.
# See supabase/whatsapp_log.sql and utils/whatsapp.ts for setup details.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANGUAGE=en
# Concierge number customers are handed off to (E.164, digits only)
WHATSAPP_CONCIERGE_NUMBER=254786530713
